<?xml version="1.0" encoding="utf-8"?>
<!--
   HANYA untuk build debug (debug/ menimpa res/xml milik main/).

   Backend default di local.properties adalah http://10.0.2.2:8000/api/
   (emulator) atau http://127.0.0.1:8000/api/ (perangkat dengan adb reverse).
   Tanpa pengecualian ini, network_security_config utama memblokir cleartext
   dan aplikasi debug gagal terhubung tanpa pesan yang jelas.

   Build release TETAP memakai app/src/main/res/xml/network_security_config.xml
   yang melarang semua cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
