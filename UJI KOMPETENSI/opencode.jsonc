{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  //  Project config — UJI KOMPETENSI
  //  Provider: ruster9 (endpoint OpenAI-compatible)
  //  API key TIDAK ditulis di file ini. Dibaca dari:
  //    ~/.config/opencode/.secrets/ruster9.key
  //  Jangan pernah hardcode key di file yang di-commit.
  // ============================================================

  // Model default untuk project ini. Ganti lewat /models kapan saja.
  "model": "ruster9/deepseek-v4.1-flash",

  "providers": {
    "ruster9": {
      "name": "ruster9",

      // Nama env var yang boleh menyediakan credential (opsional).
      // Kalau RUSTER9_API_KEY di-set, nilainya dipakai.
      "env": ["RUSTER9_API_KEY"],

      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.ruster9.id/v1",
        "apiKey": "{file:~/.config/opencode/.secrets/ruster9.key}"
      },

      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": { "context": 1000000, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": { "context": 1000000, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "qwen3.8-flash": {
          "name": "Qwen 3.8 Flash",
          "limit": { "context": 1000000, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "qwen3.8-max": {
          "name": "Qwen 3.8 Max",
          "limit": { "context": 1000000, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": { "context": 1000000, "output": 384000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1000000, "output": 384000 },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "limit": { "context": 1050000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": { "context": 1000000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "limit": { "context": 1000000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": false,
            "reasoning": { "supported": true }
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": { "context": 1000000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": false,
            "reasoning": { "supported": true }
          }
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "limit": { "context": 1048576, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true }
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "limit": { "context": 262144, "output": 262144 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": false,
            "reasoning": { "supported": true }
          }
        }
      }
    }
  },

  "agents": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "ruster9/deepseek-v4.1-flash"
    }
  }
}
